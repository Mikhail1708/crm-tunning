POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=crm_db
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@db:5432/crm_db

JWT_SECRET=replace-with-a-long-random-jwt-secret
INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key
SITE_WEBHOOK_URL=http://host.docker.internal:5001/api/webhooks/crm/order-status
WEBHOOK_SECRET=replace-with-a-different-long-random-webhook-secret
CRM_STATUS_OUTBOX_POLL_MS=1000
CRM_STATUS_OUTBOX_STALE_MS=60000
CRM_STATUS_OUTBOX_RETRY_BASE_MS=1000
CRM_STATUS_OUTBOX_RETRY_MAX_MS=900000

GRAFANA_PASSWORD=replace-with-a-strong-grafana-password
